<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F5FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡 CyberShield"
            android:textColor="#123B70"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Cybersecurity Tips"
            android:textColor="#172B4D"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Small habits can make a big difference to your online safety."
            android:textColor="#667085"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnTipPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#1769AA"
            android:text="1. Strong Passwords"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnTip2FA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1769AA"
            android:text="2. Two-Factor Authentication"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnTipWifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1769AA"
            android:text="3. Public Wi-Fi Safety"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnTipUpdates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1769AA"
            android:text="4. Software Updates"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnTipPrivacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#1769AA"
            android:text="5. Protect Your Privacy"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#DCEAFE"
            android:padding="16dp"
            android:text="Remember: Think before you click. Never share passwords or OTP codes."
            android:textColor="#123B70"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnTipsBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Back to Home"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
