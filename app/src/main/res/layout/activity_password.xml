<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F5FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡 CyberShield"
            android:textColor="#123B70"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Password Strength Checker"
            android:textColor="#172B4D"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Check whether a password meets common security recommendations."
            android:textColor="#667085"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:hint="Enter a test password"
            android:inputType="textPassword"
            android:padding="14dp"
            android:singleLine="true"
            android:autofillHints=""
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/btnShowHide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#64748B"
            android:text="Show Password"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnCheckStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1769AA"
            android:text="Check Strength"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvStrength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:padding="20dp"
            android:text="Your password result will appear here."
            android:textColor="#172B4D"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Back to Home"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
